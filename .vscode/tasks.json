{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Firebase Emulator",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-Command",
        "$env:JAVA_HOME = Join-Path $env:ProgramFiles 'Android\\Android Studio\\jbr'; $env:Path = \"$env:JAVA_HOME\\bin;$env:Path\"; firebase emulators:start --only 'auth,firestore' --project yuk-kasir-laundry"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "firebase",
        "pattern": {
          "regexp": "^NEVER_MATCH_FIREBASE_DIAGNOSTIC$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting emulators.*",
          "endsPattern": ".*All emulators ready.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
