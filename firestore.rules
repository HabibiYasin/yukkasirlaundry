rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null;}
  function member(s){return signed() && request.auth.uid in get(/databases/$(database)/documents/stores/$(s)).data.memberIds;}
  function owner(s){return signed() && get(/databases/$(database)/documents/stores/$(s)).data.ownerId == request.auth.uid;}
  match /users/{uid} {
   allow read: if signed() && request.auth.uid == uid;
   allow update: if signed() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','printerWidth']) && request.resource.data.name is string && request.resource.data.phone is string;
  }
  match /stores/{sid} {
   allow read: if signed() && request.auth.uid in resource.data.memberIds;
   allow update: if owner(sid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','city','address']) && request.resource.data.name == resource.data.name;
   match /orders/{id} {allow read: if member(sid); match /events/{eventId} {allow read: if member(sid);}}
   match /members/{id} {allow read: if member(sid);}
   match /services/{id} {allow read: if member(sid); allow create,update: if owner(sid) && request.resource.data.values is list && request.resource.data.values.size() == 19; allow delete: if owner(sid);}
   match /customers/{id} {allow read: if member(sid); allow create,update: if member(sid) && request.resource.data.keys().hasOnly(['name','phone','address']) && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.phone is string; allow delete: if owner(sid);}
  }
  match /invitations/{id} {allow read: if owner(resource.data.storeId);}
 }
}
